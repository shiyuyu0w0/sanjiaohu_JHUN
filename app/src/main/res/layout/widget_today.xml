<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:forceDarkAllowed="false"
    android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<LinearLayout
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="10dp" android:orientation="horizontal" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_picture_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.29" android:orientation="vertical" android:gravity="center_horizontal" android:contentDescription="自定义小组件图片">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/widget_date_background" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/widget_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日" android:textColor="@color/widget_text" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"/>
            <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="三角狐课表" android:textColor="@color/widget_accent" android:textSize="10sp" android:layout_marginTop="2dp" android:includeFontPadding="false"/>
        </LinearLayout>
        <ImageView android:id="@+id/widget_photo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:layout_marginBottom="5dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:src="@drawable/launcher_art" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginLeft="10dp" android:background="@color/widget_divider" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/widget_schedule_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.71" android:paddingLeft="11dp" android:orientation="vertical" android:contentDescription="今日课程，点击打开课表">
        <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="22dp" android:text="今日课表" android:textColor="@color/widget_muted" android:textSize="11sp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
        <LinearLayout android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone"/>
        <LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="把课表放到桌面" android:textSize="15sp" android:textColor="@color/widget_text" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/widget_empty_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="左侧图片支持自定义" android:textSize="11sp" android:textColor="@color/widget_muted"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:text="三角狐" android:textSize="10sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
