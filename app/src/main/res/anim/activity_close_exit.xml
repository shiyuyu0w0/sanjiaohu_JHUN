<?xml version="1.0" encoding="utf-8"?>
<!-- 返回：当前页向右滑出并淡出。退场比进场快一点，手感更利落。 -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:shareInterpolator="true">
    <translate android:fromXDelta="0%" android:toXDelta="22%" android:duration="240"/>
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="200"/>
    <scale
        android:fromXScale="1" android:toXScale="0.97"
        android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%p" android:pivotY="50%p"
        android:duration="240"/>
</set>
