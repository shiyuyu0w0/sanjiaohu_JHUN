# --- 构建产物 ---
.gradle/
build/
**/build/

# --- 本机工具链路径 ---
# Android Studio / AGP 生成，内容为本机 SDK 绝对路径，换机器即失效
local.properties

# --- 签名密钥：泄露等于他人可冒名签名，永不提交 ---
signing/
*.jks
*.keystore
development.keystore

# --- 打包产物 ---
*.apk
*.apk.idsig
*.aab

# --- 凭据/会话：绝不提交 ---
# 电费接口的 SESSION/sid 等同登录凭证，抓包或调试脚本里极易残留
.cookies
*cookie*.txt
*session*.txt
*idserial*
# 本地 jbr / Android SDK 绝对路径
local.properties

# --- 临时调试脚本与输出 ---
# 一次性排查用的抓取/编译脚本，不属于产品代码
probe*.cjs
dir-*.cjs
tmp-*.cjs
scratch/
# 编译与诊断的临时产物
args.txt
javac-*.txt
*-err.txt
err.txt
*-check.txt
*-flow.txt
*-names.txt
result.txt

# --- IDE ---
.idea/
*.iml

# --- 操作系统垃圾文件 ---
.DS_Store
Thumbs.db

# --- 其它生成物 ---
captures/
out/
lint-results*.html
